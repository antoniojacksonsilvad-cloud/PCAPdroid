<?xml version="1.0" encoding="utf-8"?>
<!-- Top border used to separate the bottom bar from the content -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rewriteSurface" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/rewriteBorder" />
        </shape>
    </item>
</layer-list>
