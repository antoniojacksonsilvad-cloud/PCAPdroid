<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rewriteBg">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rewriteBg"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rewriteBg"
            app:titleTextColor="@color/rewriteCyan"
            app:popupTheme="@style/PopupOverlay" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rewrite_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="10dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rewrite_screen_title"
                android:textColor="@color/rewriteCyan"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/rewrite_subtitle"
                android:textColor="@color/rewriteTextDim"
                android:textSize="13sp" />

            <!-- Master switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_rewrite_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rewrite_master_switch"
                    android:textColor="@color/rewriteText"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/rewrite_master_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/rewrite_master_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/rewrite_master_switch_off"
                android:textColor="@color/rewriteDanger"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Import / clear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/rewrite_import"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/rewrite_import"
                    android:textColor="@color/rewriteCyan"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_file_import"
                    app:iconSize="18dp"
                    app:iconTint="@color/rewriteCyan"
                    app:strokeColor="@color/rewriteCyan" />

                <Button
                    android:id="@+id/rewrite_clear"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="0.7"
                    android:text="@string/rewrite_clear"
                    android:textColor="@color/rewriteDanger"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_delete"
                    app:iconSize="18dp"
                    app:iconTint="@color/rewriteDanger"
                    app:strokeColor="@color/rewriteDanger" />
            </LinearLayout>

            <!-- Imported files -->
            <TextView
                android:id="@+id/rewrite_files_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="@color/rewriteCyan"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="XMLs Importados (2)" />

            <LinearLayout
                android:id="@+id/rewrite_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rewrite_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/rewrite_none"
                android:textColor="@color/rewriteText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rewrite_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="@string/rewrite_none_hint"
                android:textColor="@color/rewriteTextDim"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar: capture control -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_rewrite_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/rewrite_capture_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rewrite_capture_stopped"
            android:textColor="@color/rewriteTextDim"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/rewrite_play"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_rewrite_circle"
            android:backgroundTint="@color/rewriteCyan"
            android:contentDescription="@string/rewrite_capture_start"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_arrow"
            app:tint="@color/rewriteBg" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
