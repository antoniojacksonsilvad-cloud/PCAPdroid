<?xml version="1.0" encoding="utf-8"?>
<!-- A single rewrite rule, shown inside the card of its file -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/rewriteSurfaceAlt"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/rule_pattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/rewriteCyan"
        android:textSize="12sp"
        tools:text="https://api.exemplo.com/v1/usuario" />

    <TextView
        android:id="@+id/rule_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/rewriteCyanDim"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="BODY · requisição"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/rule_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/rewriteOk"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="status: 200"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/rule_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/rewriteText"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="X-Custom: Teste"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/rule_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="4"
        android:textColor="@color/rewriteTextDim"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="body: {&quot;status&quot;: &quot;ok&quot;}"
        tools:visibility="visible" />
</LinearLayout>
